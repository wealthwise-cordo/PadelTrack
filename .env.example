# Names match what Vercel's Neon integration creates (with the "storage_" prefix).
storage_POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/padeltrack"
storage_DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/padeltrack"
NEXTAUTH_URL="http://localhost:3004"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Forgot-password emails (https://resend.com). Without RESEND_API_KEY the
# email is printed to the server log instead — fine for local development.
RESEND_API_KEY=""
EMAIL_FROM="PadelTrack <no-reply@yourdomain.com>"
# Base URL for links in emails, e.g. https://yourdomain.com
APP_URL=""
