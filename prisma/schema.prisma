generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player?
}

model Season {
  id        String    @id @default(cuid())
  name      String
  status    String    @default("active") // active | closed
  startedAt DateTime  @default(now())
  closedAt  DateTime?

  playerSeasons      PlayerSeason[]
  matches            Match[]
  ptrHistory         PTRHistory[]
  americanoEvents    AmericanoEvent[]
  roundRobinEvents   RoundRobinEvent[]
  onePointEvents     OnePointEvent[]
  snakeLaddersEvents SnakeLaddersEvent[]
}

// Per-(player, season) stats. Player identity lives on `Player` forever;
// everything that resets when a new season starts lives here instead.
model PlayerSeason {
  id              String @id @default(cuid())
  playerId        String
  seasonId        String
  ptr             Float  @default(1000)
  reliability     Float  @default(0)
  matchesPlayed   Int    @default(0)
  wins            Int    @default(0)
  losses          Int    @default(0)
  setsWon         Int    @default(0)
  setsLost        Int    @default(0)
  gamesWon        Int    @default(0)
  gamesLost       Int    @default(0)
  tiebreaksWon    Int    @default(0)
  tiebreaksPlayed Int    @default(0)
  currentStreak   Int    @default(0)
  bestStreak      Int    @default(0)

  player Player @relation(fields: [playerId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([playerId, seasonId])
  @@index([seasonId])
}

model Player {
  id            String         @id @default(cuid())
  name          String
  nickname      String?
  avatarColor   String         @default("#00ff87")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id])
  ptrHistory    PTRHistory[]
  playerSeasons PlayerSeason[]
  teamA1        Match[]        @relation("TeamA1")
  teamA2        Match[]        @relation("TeamA2")
  teamB1        Match[]        @relation("TeamB1")
  teamB2        Match[]        @relation("TeamB2")
}

model Match {
  id              String       @id @default(cuid())
  playedAt        DateTime     @default(now())
  submittedAt     DateTime     @default(now())
  status          String       @default("complete")
  isRanked        Boolean      @default(true)
  winner          String?
  seasonId        String
  season          Season       @relation(fields: [seasonId], references: [id])
  teamAPlayer1Id  String
  teamAPlayer2Id  String
  teamBPlayer1Id  String
  teamBPlayer2Id  String
  teamAPlayer1    Player       @relation("TeamA1", fields: [teamAPlayer1Id], references: [id])
  teamAPlayer2    Player       @relation("TeamA2", fields: [teamAPlayer2Id], references: [id])
  teamBPlayer1    Player       @relation("TeamB1", fields: [teamBPlayer1Id], references: [id])
  teamBPlayer2    Player       @relation("TeamB2", fields: [teamBPlayer2Id], references: [id])
  teamAPTRBefore  Float
  teamBPTRBefore  Float
  teamAPTRAfter   Float
  teamBPTRAfter   Float
  ptrDelta        Float        @default(0)
  scoreMultiplier Float        @default(1)
  isUpset         Boolean      @default(false)
  matchQuality    Float        @default(0)
  notes           String?
  sets            MatchSet[]
  ptrHistory      PTRHistory[]

  @@index([seasonId])
}

model MatchSet {
  matchId    String
  setNumber  Int
  teamAGames Int
  teamBGames Int
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, setNumber])
}

model PTRHistory {
  id          String             @id @default(cuid())
  playerId    String
  matchId     String?
  eventId     String?
  seasonId    String
  ptrBefore   Float
  ptrAfter    Float
  delta       Float
  reliability Float
  createdAt   DateTime           @default(now())
  player      Player             @relation(fields: [playerId], references: [id])
  match       Match?             @relation(fields: [matchId], references: [id])
  event       AmericanoEvent?    @relation(fields: [eventId], references: [id])
  season      Season             @relation(fields: [seasonId], references: [id])
  rrEventId   String?
  rrEvent     RoundRobinEvent?   @relation(fields: [rrEventId], references: [id])
  opEventId   String?
  opEvent     OnePointEvent?     @relation(fields: [opEventId], references: [id])
  slEventId   String?
  slEvent     SnakeLaddersEvent? @relation(fields: [slEventId], references: [id])

  @@index([seasonId])
}

model AmericanoEvent {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())
  status     String           @default("in_progress") // in_progress | complete
  scoreMode  String // "points" | "games"
  target     Int
  isRanked   Boolean          @default(true)
  seasonId   String
  season     Season           @relation(fields: [seasonId], references: [id])
  playerIds  String[]
  ptrDeltas  Json? // { [playerId]: delta } applied when the event completed
  matches    AmericanoMatch[]
  ptrHistory PTRHistory[]

  @@index([seasonId])
}

model AmericanoMatch {
  id             String         @id @default(cuid())
  eventId        String
  round          Int
  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String
  teamAScore     Int?
  teamBScore     Int?
  status         String         @default("pending") // pending | complete
  event          AmericanoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model RoundRobinEvent {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  status        String            @default("in_progress") // in_progress | complete
  target        Int // games target, first-to (not best-of)
  isRanked      Boolean           @default(true)
  seasonId      String
  season        Season            @relation(fields: [seasonId], references: [id])
  teamPlayerIds String[] // flattened, consecutive pairs = teams: [t0p1,t0p2,t1p1,t1p2,...]
  ptrDeltas     Json? // { [playerId]: delta } applied when the event completed
  matches       RoundRobinMatch[]
  ptrHistory    PTRHistory[]

  @@index([seasonId])
}

model RoundRobinMatch {
  id             String          @id @default(cuid())
  eventId        String
  round          Int
  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String
  teamAScore     Int?
  teamBScore     Int?
  status         String          @default("pending") // pending | complete
  event          RoundRobinEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model OnePointEvent {
  id         String          @id @default(cuid())
  createdAt  DateTime        @default(now())
  status     String          @default("in_progress") // in_progress | complete
  seasonId   String
  season     Season          @relation(fields: [seasonId], references: [id])
  playerIds  String[] // exactly 8, in bracket slot order (position 1..8)
  ptrDeltas  Json? // { [playerId]: delta } applied when the event completed
  matches    OnePointMatch[]
  ptrHistory PTRHistory[]

  @@index([seasonId])
}

model OnePointMatch {
  id        String        @id @default(cuid())
  eventId   String
  round     Int // 1 = quarterfinal, 2 = semifinal, 3 = final
  position  Int // 1-based position within the round
  sequence  Int // play order across the whole bracket (top of the draw, moving down)
  player1Id String? // null until the feeding match(es) resolve, for round 2/3
  player2Id String?
  winnerId  String?
  status    String        @default("pending") // pending | complete
  event     OnePointEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model SnakeLaddersEvent {
  id          String              @id @default(cuid())
  createdAt   DateTime            @default(now())
  status      String              @default("in_progress") // in_progress | complete
  scoreMode   String // "points" | "games"
  target      Int
  totalRounds Int
  isRanked    Boolean             @default(true)
  seasonId    String
  season      Season              @relation(fields: [seasonId], references: [id])
  playerIds   String[] // exactly 8, seeded by PTR desc at creation (ranks 1-8)
  ptrDeltas   Json? // { [playerId]: delta } applied when the event completed
  matches     SnakeLaddersMatch[]
  ptrHistory  PTRHistory[]

  @@index([seasonId])
}

model SnakeLaddersMatch {
  id             String            @id @default(cuid())
  eventId        String
  round          Int
  court          String // "top" | "bottom"
  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String
  teamAScore     Int?
  teamBScore     Int?
  status         String            @default("pending") // pending | complete
  event          SnakeLaddersEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
