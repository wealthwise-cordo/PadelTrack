generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("storage_POSTGRES_PRISMA_URL")
  directUrl = env("storage_DATABASE_URL_UNPOOLED")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String
  name            String
  // Collected on direct sign-up (not when claiming a guest invite).
  gender          String? // male | female | other
  dateOfBirth     DateTime?       @db.Date
  country         String? // ISO 3166-1 alpha-2, e.g. GB
  // When the terms of use (incl. liability) and privacy notice were accepted at
  // sign-up, and which version (see src/lib/legal.ts).
  termsAcceptedAt DateTime?
  termsVersion    String?
  // member | leveller | superuser. Levellers can propose rating adjustments
  // for the super user to review; the super user (also anyone in
  // ADMIN_EMAILS) sees analytics and adjusts ratings without review.
  role            String          @default("member")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  player          Player?         @relation("UserPlayer")
  passwordResets  PasswordReset[]
  signIns         SignIn[]
  activeDays      ActiveDay[]

  guestsCreated      Player[]            @relation("GuestCreator")
  matchesRecorded    Match[]             @relation("MatchRecorder")
  matchesOrganised   Match[]             @relation("MatchOrganiser")
  scoreReports       MatchScoreReport[]
  americanoEvents    AmericanoEvent[]    @relation("AmericanoEventOwner")
  roundRobinEvents   RoundRobinEvent[]   @relation("RoundRobinEventOwner")
  snakeLaddersEvents SnakeLaddersEvent[] @relation("SnakeLaddersEventOwner")
  PushSubscription   PushSubscription[]

  adminMatchActions    AdminMatchAction[]
  adminUserActions     AdminUserAction[]
  adjustmentsRequested RatingAdjustment[] @relation("AdjustmentRequester")
  adjustmentsReviewed  RatingAdjustment[] @relation("AdjustmentReviewer")
}

// A person who plays. Registered users have exactly one Player (userId set).
// Guests are Players with no userId, created by a user (createdById) when
// adding someone who isn't on the app yet. A guest can later be claimed via
// their claimToken invite link, which attaches it to the new user's account
// along with its rating and match history.
model Player {
  id              String    @id @default(cuid())
  name            String
  nickname        String?
  avatarColor     String    @default("#f97316")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String?   @unique
  user            User?     @relation("UserPlayer", fields: [userId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?     @relation("GuestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  claimToken      String?   @unique
  // The LTA level (1.0–7.0) a player picked when they signed up; their
  // rating starts there.
  startingLevel   Float?
  // For guests: the level the person adding them thought they were. Only
  // pre-selects the guest's own choice when they sign up — guests have no
  // rating until then.
  suggestedLevel  Float?
  // A ranked guest: the super user verified this guest (Admin → Users) and
  // set their level, so their ranked matches count without them joining.
  // They stay out of circles and rankings until they do. Temporary, while
  // few players are on the app.
  rankedGuestAt   DateTime?
  rankedGuestById String?
  // Set when the player's account was deleted: the profile is anonymised and
  // detached from its user, but stays in the matches it played so other
  // players' records and ratings are unchanged.
  deletedAt       DateTime?

  // Rating and career stats — only confirmed ranked matches move these.
  ptr                Float     @default(1000)
  // 0.01–1.0: how settled the rating is (the inverse of volatility). Grows
  // with each ranked match and decays after 30+ days without one — see
  // ptr-algorithm.ts. lastRankedPlayedAt is the latest ranked match played.
  reliability        Float     @default(0.01)
  lastRankedPlayedAt DateTime?
  matchesPlayed      Int       @default(0)
  wins               Int       @default(0)
  losses             Int       @default(0)
  setsWon            Int       @default(0)
  setsLost           Int       @default(0)
  gamesWon           Int       @default(0)
  gamesLost          Int       @default(0)
  tiebreaksWon       Int       @default(0)
  tiebreaksPlayed    Int       @default(0)
  currentStreak      Int       @default(0)
  bestStreak         Int       @default(0)

  ptrHistory  PTRHistory[]
  adjustments RatingAdjustment[]
  teamA1      Match[]            @relation("TeamA1")
  teamA2      Match[]            @relation("TeamA2")
  teamB1      Match[]            @relation("TeamB1")
  teamB2      Match[]            @relation("TeamB2")

  @@index([createdById])
}

// A match. Friendlies are saved as "complete" straight away. Ranked matches
// start "pending" and become ranked once (a) a registered opponent confirms
// the score and (b) every guest in the match has joined PadelTrack or is a
// ranked guest. If both opponents are guests the registered partner confirms;
// with three guests only the super user can. After 48 hours: if a guest still
// hasn't joined it becomes a friendly permanently; otherwise it confirms
// itself, unless nobody could have confirmed it (three guests).
model Match {
  id                String             @id @default(cuid())
  playedAt          DateTime           @default(now())
  submittedAt       DateTime           @default(now())
  confirmedAt       DateTime?
  // True when nobody confirmed within the 48-hour window and it confirmed itself.
  autoConfirmed     Boolean            @default(false)
  // When an opponent confirmed the score. A ranked match with guests in it
  // also needs every guest to join PadelTrack before it becomes ranked.
  scoreConfirmedAt  DateTime?
  // A ranked match whose guest(s) didn't join within 48 hours is turned into
  // a friendly for good.
  becameFriendly    Boolean            @default(false)
  status            String             @default("pending") // scheduled | pending | complete
  // Friendly matches are saved straight away and never touch ratings,
  // circles or stats.
  isRanked          Boolean            @default(true)
  // Play stopped before either pair won 2 sets. No winner; never changes
  // ratings, reliability, wins/losses or head-to-head. A ranked one is still
  // confirmed like any ranked match, then counts as a match played, adds its
  // finished sets and all its games to stats and joins its players' circles.
  incomplete        Boolean            @default(false)
  winner            String? // "A" | "B"; null when incomplete
  recordedById      String
  recordedBy        User               @relation("MatchRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  // Null is an open spot: only a scheduled match can have one (see below).
  teamAPlayer1Id    String?
  teamAPlayer2Id    String?
  teamBPlayer1Id    String?
  teamBPlayer2Id    String?
  teamAPlayer1      Player?            @relation("TeamA1", fields: [teamAPlayer1Id], references: [id], onDelete: Restrict)
  teamAPlayer2      Player?            @relation("TeamA2", fields: [teamAPlayer2Id], references: [id], onDelete: Restrict)
  teamBPlayer1      Player?            @relation("TeamB1", fields: [teamBPlayer1Id], references: [id], onDelete: Restrict)
  teamBPlayer2      Player?            @relation("TeamB2", fields: [teamBPlayer2Id], references: [id], onDelete: Restrict)
  // Filled in when the match is confirmed and ratings are applied.
  teamAPTRBefore    Float              @default(0)
  teamBPTRBefore    Float              @default(0)
  teamAPTRAfter     Float              @default(0)
  teamBPTRAfter     Float              @default(0)
  ptrDelta          Float              @default(0)
  scoreMultiplier   Float              @default(1)
  isUpset           Boolean            @default(false)
  matchQuality      Float              @default(0)
  // Scheduled matches: set up ahead of time with no score (status
  // "scheduled", playedAt = start time). The organiser can edit or cancel it
  // until a score is in, including leaving player spots open and filling,
  // swapping or clearing them later; the score needs all four. Players get a
  // reminder 25 hours before (reminderSentAt) and a prompt to add the score
  // 2 hours after the start (scorePromptSentAt). Any player can then enter
  // the score; each entry is a MatchScoreReport. Two matching entries from opposite pairs confirm it;
  // different entries make it `disputed` until an opponent of one submitter
  // picks the right one. Disputed matches never auto-confirm.
  organiserId       String?
  organiser         User?              @relation("MatchOrganiser", fields: [organiserId], references: [id], onDelete: SetNull)
  reminderSentAt    DateTime?
  scorePromptSentAt DateTime?
  disputed          Boolean            @default(false)
  disputeRemindedAt DateTime?
  scoreReports      MatchScoreReport[]
  updatedAt         DateTime           @default(now()) @updatedAt
  // Where it was played, free text (e.g. "Padel Club Cartagena"). When a
  // listed club was picked, `clubId` links it and `location` holds its label.
  location          String?
  clubId            String?
  club              Club?              @relation(fields: [clubId], references: [id], onDelete: SetNull)
  notes             String?
  sets              MatchSet[]
  ptrHistory        PTRHistory[]

  @@index([teamAPlayer1Id])
  @@index([teamAPlayer2Id])
  @@index([teamBPlayer1Id])
  @@index([teamBPlayer2Id])
  @@index([status, submittedAt])
  @@index([status, playedAt])
  @@index([clubId])
}

// One player's entry of a scheduled match's score.
model MatchScoreReport {
  id            String   @id @default(cuid())
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  // [{ teamAGames, teamBGames }, …]
  sets          Json
  winner        String? // "A" | "B"; null when incomplete
  incomplete    Boolean  @default(false)
  status        String   @default("open") // open | accepted | rejected
  createdAt     DateTime @default(now())

  @@index([matchId])
}

model MatchSet {
  matchId    String
  setNumber  Int
  teamAGames Int
  teamBGames Int
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, setNumber])
}

// One rating change: from a ranked match (matchId) or a manual adjustment
// (adjustmentId).
model PTRHistory {
  id           String            @id @default(cuid())
  playerId     String
  matchId      String?
  adjustmentId String?           @unique
  ptrBefore    Float
  ptrAfter     Float
  delta        Float
  reliability  Float
  createdAt    DateTime          @default(now())
  player       Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match        Match?            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  adjustment   RatingAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// A manual change to a player's rating, with the reason for it. At most one
// LTA level either way (see rating-adjustments.ts). The super user's own
// adjustments apply at once; a leveller's wait as "pending" until the super
// user approves (applied then, as a change from the rating at that moment) or
// rejects them.
model RatingAdjustment {
  id            String      @id @default(cuid())
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?       @relation("AdjustmentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  // Internal rating points (200 = one LTA level).
  delta         Float
  reason        String
  status        String      @default("pending") // pending | approved | rejected
  // The rating when it was requested, so the reviewer sees what was asked.
  ptrAtRequest  Float
  reviewedById  String?
  reviewedBy    User?       @relation("AdjustmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime    @default(now())
  history       PTRHistory?

  @@index([status, createdAt])
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Events — standalone formats run by a user. They never touch ratings.
// playerIds reference Player rows (registered users or guests).
// ---------------------------------------------------------------------------

model AmericanoEvent {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  ownerId   String
  owner     User             @relation("AmericanoEventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  status    String           @default("in_progress") // in_progress | complete
  scoreMode String // "points" | "games"
  target    Int
  playerIds String[]
  // Courts played on at once; each round has up to this many matches.
  courts    Int              @default(1)
  matches   AmericanoMatch[]

  @@index([ownerId])
}

model AmericanoMatch {
  id             String         @id @default(cuid())
  eventId        String
  round          Int
  court          Int? // 1-based; null on events from before multiple courts
  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String
  teamAScore     Int?
  teamBScore     Int?
  status         String         @default("pending") // pending | complete
  event          AmericanoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model RoundRobinEvent {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  ownerId       String
  owner         User              @relation("RoundRobinEventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  status        String            @default("in_progress") // in_progress | complete
  target        Int // games target, first-to (not best-of)
  teamPlayerIds String[] // flattened, consecutive pairs = teams: [t0p1,t0p2,t1p1,t1p2,...]
  // Courts played on at once (1–6); matches are grouped into rounds of up to
  // this many. A league has no rounds or courts: players arrange each
  // fixture themselves and play them in any order.
  courts        Int               @default(1)
  league        Boolean           @default(false)
  // League scoring: games (first to `target`) | set (one set to 6, tie-break
  // at 6–6) | match (best of 3 sets). One-off events always use games.
  scoring       String            @default("games")
  matches       RoundRobinMatch[]

  @@index([ownerId])
}

model RoundRobinMatch {
  id             String          @id @default(cuid())
  eventId        String
  // Scheduled: the round played in, and which court (1-based). League:
  // `round` is just the fixture's list order and `court` is null.
  round          Int
  court          Int?
  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String
  // Games won; for a full match, sets won (games per set are in `sets`).
  teamAScore     Int?
  teamBScore     Int?
  // League: each set's games, [{ a, b }, …].
  sets           Json?
  // pending | submitted (league: entered, waiting for the other pair) | complete
  status         String          @default("pending")
  // League confirmation, the same rules as ranked matches: a player in the
  // match enters the score, the other pair confirms, or it confirms itself
  // after 48 hours.
  submittedById  String? // player id
  submittedAt    DateTime?
  confirmedAt    DateTime?
  autoConfirmed  Boolean         @default(false)
  event          RoundRobinEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model SnakeLaddersEvent {
  id          String              @id @default(cuid())
  createdAt   DateTime            @default(now())
  ownerId     String
  owner       User                @relation("SnakeLaddersEventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  status      String              @default("in_progress") // in_progress | complete
  scoreMode   String // "points" | "games"
  target      Int
  totalRounds Int
  // Courts in the ladder (1–4), 4 players each. Events from before this
  // setting had 2.
  courts      Int                 @default(2)
  playerIds   String[] // 4 × courts, seeded by rating desc at creation
  matches     SnakeLaddersMatch[]

  @@index([ownerId])
}

model SnakeLaddersMatch {
  id             String            @id @default(cuid())
  eventId        String
  round          Int
  court          String // "1" (top) … "4"; older events: "top" | "bottom"
  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String
  teamAScore     Int?
  teamBScore     Int?
  status         String            @default("pending") // pending | complete
  event          SnakeLaddersEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, round, court])
  @@index([eventId])
}

// Padel venues offered in the match location picker. Add new regions or
// venue changes with a migration; set `active` false to hide a closed club
// without breaking matches already played there.
model Club {
  id        String   @id @default(cuid())
  name      String
  // Neighbourhood, to tell apart sites of the same chain ("Battersea").
  area      String
  city      String
  country   String   @default("GB") // ISO 3166-1 alpha-2
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matches   Match[]

  @@unique([name, area, city])
  @@index([city, active])
}

// "Forgot password" links. Only a SHA-256 hash of the emailed token is kept;
// a link works once, within an hour, and using one cancels the others.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Analytics (admin page). Recorded from the deploy that added them onwards.
// ---------------------------------------------------------------------------

// Each successful sign-in with email and password.
model SignIn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One row per user per day they opened a signed-in page. Sessions last for
// weeks, so this — not sign-ins — is the measure of active use.
model ActiveDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@id([userId, day])
  @@index([day])
}

// Errors caught on the server (API routes) and in the browser (error
// boundaries). Kept 90 days.
model ErrorLog {
  id        String   @id @default(cuid())
  source    String // server | client
  message   String
  stack     String?
  path      String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A match that was deleted — kept so the admin page can track withdrawals
// (the recorder deleting their own) and rejections (another player deleting
// one that was pending). The match itself is gone.
model MatchDeletion {
  id               String   @id @default(cuid())
  matchId          String
  wasPending       Boolean
  wasRanked        Boolean
  byRecorder       Boolean
  matchSubmittedAt DateTime
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// A device that turned on phone notifications (Web Push). One user can have
// several; dead ones are removed when the push service rejects them.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// The super user stepping in on a match that isn't confirmed yet: confirming
// it, settling a disputed score, or voiding it (which deletes it). Always
// with a reason; the players are told. `summary` describes the match as it
// was, since a voided one is gone.
model AdminMatchAction {
  id        String   @id @default(cuid())
  matchId   String
  action    String // confirm | settle | void
  reason    String
  summary   String
  byId      String?
  by        User?    @relation(fields: [byId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Two players the super user marked as different people in Admin → Users,
// so the duplicate check stops suggesting them. playerAId < playerBId.
model DuplicateDismissal {
  id        String   @id @default(cuid())
  playerAId String
  playerBId String
  byId      String?
  createdAt DateTime @default(now())

  @@unique([playerAId, playerBId])
}

// The super user's actions in Admin → Users, for the record: verifying a
// ranked guest, merging a duplicate (detail keeps the deleted guest as it
// was) and marking two players as different people.
model AdminUserAction {
  id        String   @id @default(cuid())
  action    String // verify | merge | dismiss
  summary   String
  detail    Json?
  byId      String?
  by        User?    @relation(fields: [byId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
